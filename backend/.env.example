# SQLite file (relative to the backend folder)
DATABASE_URL=sqlite:///./zoom_clone.db

# Public URL of the frontend - used to build invite links
FRONTEND_URL=http://localhost:3000

# Comma separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Signs the WebSocket join tokens - change this in production
SECRET_KEY=dev-secret-change-me

# The "logged in" user (seeded on first start)
DEFAULT_USER_EMAIL=bhavya.talwar@example.com
SEED_ON_STARTUP=true
